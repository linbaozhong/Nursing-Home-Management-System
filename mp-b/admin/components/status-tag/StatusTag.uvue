<template>
	<view class="status-tag" :style="{ backgroundColor: bgColor, color: fgColor }">
		<text class="status-tag__text">{{ text }}</text>
	</view>
</template>

<script setup lang="uts">
	/**
	 * StatusTag 状态标签
	 * 官方 uni-badge-view 为数字角标，不适用于文字状态标签，故自建。
	 * 色板见规格文档 §9.6：
	 *   primary=蓝(#007aff)  success=绿(#4cd964)  warning=橙(#f0ad4e)  danger=红(#dd524d)  default=灰(#999999)
	 */
	type TagType = 'primary' | 'success' | 'warning' | 'danger' | 'default'

	const props = withDefaults(defineProps<{
		text: string
		type?: TagType
	}>(), {
		text: '',
		type: 'default'
	})

	const COLOR_MAP: Record<string, string> = {
		primary: '#007AFF',
		success: '#4CD964',
		warning: '#F0AD4E',
		danger: '#DD524D',
		default: '#999999'
	}

	const bgColor = computed((): string => {
		// 淡色底 = 主色 + 透明度（用 rgba 直接取色）
		return hexToRgba(COLOR_MAP[props.type] || COLOR_MAP['default'], 0.12)
	})

	const fgColor = computed((): string => {
		return COLOR_MAP[props.type] || COLOR_MAP['default']
	})

	function hexToRgba(hex: string, alpha: number): string {
		let h = hex.replace('#', '')
		if (h.length == 3) {
			h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2]
		}
		const r = parseInt(h.substring(0, 2), 16)
		const g = parseInt(h.substring(2, 4), 16)
		const b = parseInt(h.substring(4, 6), 16)
		return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')'
	}
</script>

<style scoped>
	.status-tag {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 20px;
		padding-left: 8px;
		padding-right: 8px;
		border-radius: 4px;
		flex-shrink: 0;
	}

	.status-tag__text {
		font-size: 12px;
		font-weight: 400;
	}
</style>
