<template>
	<view v-if="visible" class="es-mask" @click="close">
		<view class="es-panel" @click.stop>
			<view class="es-header">
				<text class="es-title">选择老人</text>
				<text class="es-cancel" @click="close">取消</text>
			</view>
			<view class="es-search">
				<input
					class="es-input"
					v-model="keyword"
					placeholder="输入老人姓名搜索"
					confirm-type="search"
					@confirm="doSearch"
				/>
				<text class="es-search-btn" @click="doSearch">搜索</text>
			</view>
			<scroll-view class="es-list" scroll-y>
				<view
					v-for="item in list"
					:key="item.id"
					class="es-item"
					@click="onSelect(item)"
				>
					<view class="es-item__main">
						<text class="es-item__name">{{ item.name }}</text>
						<text class="es-item__tail">尾号{{ idNumTail(item.id_num) }}</text>
					</view>
					<view class="es-item__sub">
						<text class="es-item__phone">{{ item.phone }}</text>
						<StatusTag :text="checkFlagText(item.check_flag)" type="success" />
					</view>
				</view>
				<view v-if="list.length == 0" class="es-empty">
					<text>无匹配老人</text>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { pageSearchElderByKey, ElderItem } from '../../api/elder'
	import { idNumTail } from '../../utils/util'

	/**
	 * ElderSearch 长者搜索器（半屏弹层）
	 * 数据源：/elderRecord/pageSearchElderByKey（page_size=200 全量本地过滤）
	 */
	const props = withDefaults(defineProps<{
		visible: boolean
		placeholder?: string
	}>(), {
		visible: false,
		placeholder: '输入老人姓名'
	})

	const emit = defineEmits<{
		(e: 'update:visible', value: boolean): void
		(e: 'select', value: ElderItem): void
		(e: 'close'): void
	}>()

	const keyword = ref('')
	const list = ref<ElderItem[]>([])
	const allList = ref<ElderItem[]>([])

	watch(() => props.visible, (v: boolean) => {
		if (v && allList.value.length == 0) {
			loadAll()
		}
	})

	async function loadAll() {
		const res = await pageSearchElderByKey()
		allList.value = res.list
		list.value = res.list
	}

	function doSearch() {
		const kw = keyword.value.trim()
		if (kw == '') {
			list.value = allList.value
			return
		}
		list.value = allList.value.filter((it) => {
			return it.name.indexOf(kw) >= 0
		})
	}

	function onSelect(item: ElderItem) {
		emit('select', item)
		close()
	}

	function checkFlagText(flag: string): string {
		if (flag == '1') {
			return '入住中'
		}
		return '未入住'
	}

	function close() {
		emit('update:visible', false)
		emit('close')
	}
</script>

