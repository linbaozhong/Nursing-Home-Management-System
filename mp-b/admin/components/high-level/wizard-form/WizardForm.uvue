<template>
	<view class="wizard">
		<!-- Step 指示器 -->
		<view class="wizard__steps">
			<view v-for="(s, i) in steps" :key="i" class="wizard__step">
				<view
					class="wizard__dot"
					:class="{
						'wizard__dot--active': i == current,
						'wizard__dot--done': i < current
					}"
				>
					<text v-if="i < current" class="wizard__dot-text">✓</text>
					<text v-else class="wizard__dot-text">{{ i + 1 }}</text>
				</view>
				<text class="wizard__label" :class="{ 'wizard__label--active': i == current }">{{ s }}</text>
				<view v-if="i < steps.length - 1" class="wizard__line" :class="{ 'wizard__line--done': i < current }"></view>
			</view>
		</view>

		<!-- 当前步内容 -->
		<view class="wizard__content">
			<slot :name="'step-' + current"></slot>
		</view>

		<!-- 底部按钮 -->
		<view class="wizard__footer">
			<view v-if="current > 0" class="wizard__btn wizard__btn--ghost" @click="onPrev">
				<text>上一步</text>
			</view>
			<view
				v-if="current < steps.length - 1"
				class="wizard__btn wizard__btn--primary"
				@click="onNext"
			>
				<text>下一步</text>
			</view>
			<view
				v-else
				class="wizard__btn wizard__btn--primary"
				:class="{ 'wizard__btn--disabled': disabled }"
				@click="onSubmit"
			>
				<text>{{ submitText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * WizardForm 多步向导模板
	 * 外出/来访/事故/点餐 4 个新增向导复用（契约见规格文档 §9.2）
	 * 每步内容通过 <template #step-0> / #step-1 等插槽注入
	 */
	const props = withDefaults(defineProps<{
		steps: string[]
		current?: number
		submitText?: string
		disabled?: boolean
	}>(), {
		steps: () => [],
		current: 0,
		submitText: '提交',
		disabled: false
	})

	const emit = defineEmits<{
		(e: 'update:current', value: number): void
		(e: 'change', value: number): void
		(e: 'prev'): void
		(e: 'next'): void
		(e: 'submit'): void
	}>()

	/**
	 * 前进/后退由父组件业务校验后驱动：
	 * - 组件只 emit `prev`/`next`，不自行改 current
	 * - 父组件校验通过后通过 v-model:current 推进
	 */
	function onPrev() {
		if (props.current <= 0) {
			return
		}
		emit('prev')
	}

	function onNext() {
		if (props.current >= props.steps.length - 1) {
			return
		}
		emit('next')
	}

	function onSubmit() {
		if (props.disabled) {
			return
		}
		emit('submit')
	}
</script>

<style scoped>
	.wizard {
		flex: 1;
		flex-direction: column;
	}

	.wizard__steps {
		flex-direction: row;
		align-items: flex-start;
		background-color: #FFFFFF;
		padding: 14px 16px;
	}

	.wizard__step {
		flex: 1;
		flex-direction: column;
		align-items: center;
		position: relative;
	}

	.wizard__dot {
		width: 24px;
		height: 24px;
		border-radius: 12px;
		background-color: #E5E6EB;
		align-items: center;
		justify-content: center;
	}

	.wizard__dot--active {
		background-color: #007AFF;
	}

	.wizard__dot--done {
		background-color: #4CD964;
	}

	.wizard__dot-text {
		font-size: 13px;
		color: #FFFFFF;
	}

	.wizard__label {
		margin-top: 6px;
		font-size: 12px;
		color: #999999;
		text-align: center;
	}

	.wizard__label--active {
		color: #007AFF;
		font-weight: 600;
	}

	.wizard__line {
		position: absolute;
		top: 12px;
		left: 50%;
		width: 100%;
		height: 2px;
		background-color: #E5E6EB;
	}

	.wizard__line--done {
		background-color: #4CD964;
	}

	.wizard__content {
		flex: 1;
		padding: 12px 16px;
	}

	.wizard__footer {
		flex-direction: row;
		justify-content: center;
		padding: 12px 16px;
		padding-bottom: calc(12px + constant(safe-area-inset-bottom));
		padding-bottom: calc(12px + env(safe-area-inset-bottom));
		background-color: #FFFFFF;
	}

	.wizard__btn {
		flex: 1;
		height: 46px;
		border-radius: 23px;
		align-items: center;
		justify-content: center;
		margin-left: 8px;
		margin-right: 8px;
	}

	.wizard__btn--primary {
		background-color: #007AFF;
	}

	.wizard__btn--primary text {
		color: #FFFFFF;
		font-size: 15px;
	}

	.wizard__btn--ghost {
		background-color: #F5F6FA;
	}

	.wizard__btn--ghost text {
		color: #333333;
		font-size: 15px;
	}

	.wizard__btn--disabled {
		opacity: 0.4;
	}
</style>
