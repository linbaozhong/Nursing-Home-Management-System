	}

	.bar-row__track {
		flex: 1;
		height: 12px;
		border-radius: 6px;
		background-color: #F0F0F0;
		overflow: hidden;
	}

	.bar-row__fill {
		height: 12px;
		border-radius: 6px;
		background-color: #007AFF;
	}

	.bar-row__num {
		width: 40px;
		text-align: right;
		font-size: 13px;
		color: #666666;
	}

	.rank-head {
		flex-direction: row;
		justify-content: space-between;
		margin-top: 8px;
	}

	.rank-head text {
		font-size: 12px;
		color: #999999;
	}

	.rank-row {
		flex-direction: row;
		align-items: center;
		margin-top: 8px;
	}

	.rank-row__no {
		width: 20px;
		font-size: 14px;
		color: #DD524D;
		font-weight: 600;
	}

	.rank-row__name {
		flex: 1;
		font-size: 14px;
		color: #333333;
	}

	.rank-row__num {
		font-size: 12px;
		color: #999999;
	}
</style>
