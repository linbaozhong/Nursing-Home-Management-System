<template>
	<view class="page">
		<uni-nav-bar :title="'入住签约'" />

		<WizardForm
			:steps="['合同信息', '护理与床位', '确认']"
			:current="current"
			:disabled="submitting"
			@next="onNext"
			@prev="onPrev"
			@submit="doSubmit"
		>
			<!-- 第一步：老人 + 合同基本信息 -->
			<template #step-0>
				<view class="step">
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">老人姓名</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="form.name" placeholder="请输入姓名" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">身份证号</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="form.id_num" :maxlength="18" placeholder="18 位身份证号" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">性别</text>
							<text class="field__required">*</text>
						</view>
						<view class="radio-row">
							<view v-for="g in sexOptions" :key="g"
								class="radio" :class="{ 'radio--active': form.sex == g }"
								@click="form.sex = g">
								<text>{{ g }}</text>
							</view>
						</view>
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">年龄</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="ageStr" type="number" placeholder="0-120" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">电话</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="form.phone" type="number" :maxlength="11" placeholder="11 位手机号" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">地址</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="form.address" placeholder="请输入地址" />
					</view>
				</view>
			</template>

			<!-- 第二步：护理等级 + 餐饮套餐 + 床位 + 合同日期 -->
			<template #step-1>
				<view class="step">
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">护理等级</text>
							<text class="field__required">*</text>
						</view>
						<view v-for="n in nurseGrades" :key="n.id"
							class="option" :class="{ 'option--active': form.nursing_grade_id == n.id }"
							@click="form.nursing_grade_id = n.id">
							<text>{{ n.name }}</text>
						</view>
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">餐饮套餐</text>
							<text class="field__required">*</text>
						</view>
						<view v-for="c in cateringSets" :key="c.id"
							class="option" :class="{ 'option--active': form.catering_set_id == c.id }"
							@click="form.catering_set_id = c.id">
							<text>{{ c.name }}</text>
						</view>
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">床位</text>
							<text class="field__required">*</text>
						</view>
						<view v-for="b in beds" :key="b.id"
							class="option" :class="{ 'option--active': form.bed_id == b.id }"
							@click="form.bed_id = b.id">
							<text>{{ b.name }}</text>
						</view>
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">合同开始日期</text>
							<text class="field__required">*</text>
						</view>
						<DateTimePicker v-model="form.start_date" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">合同结束日期</text>
							<text class="field__required">*</text>
						</view>
						<DateTimePicker v-model="form.end_date" />
					</view>
				</view>
			</template>

			<!-- 第三步：紧急联系人 + 确认 -->
			<template #step-2>
				<view class="step">
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">紧急联系人</text>
							<text class="field__required">*</text>
						</view>
						<view v-for="(c, idx) in contacts" :key="idx" class="contact">
							<input class="field__input contact__input" v-model="c.name" placeholder="姓名" />
							<input class="field__input contact__input" v-model="c.phone" type="number" :maxlength="11" placeholder="电话" />
							<input class="field__input contact__input" v-model="c.relation" placeholder="关系" />
							<text class="contact__del" @click="removeContact(idx)">删除</text>
						</view>
						<view class="contact__add" @click="addContact">
							<text>＋ 新增联系人</text>
						</view>
					</view>
					<view class="summary">
						<view class="summary__row">
							<text class="summary__label">签约老人</text>
							<text class="summary__value">{{ form.name }}</text>
						</view>
					</view>
				</view>
			</template>
		</WizardForm>
	</view>
</template>

<script setup lang="uts">
	import WizardForm from '../../components/wizard-form/WizardForm.uvue'
	import DateTimePicker from '../../components/date-time-picker/DateTimePicker.uvue'
	import { listNurseGrade, listCateringSet, listBed, addEnter, DropDownItem, BedOption } from '../../api/enter'

	const current = ref(0)
	const submitting = ref(false)
	const ageStr = ref('')
	const sexOptions = ['男', '女']

	const nurseGrades = ref<DropDownItem[]>([])
	const cateringSets = ref<DropDownItem[]>([])
	const beds = ref<BedOption[]>([])

	const form = ref<{
		name: string
		id_num: string
		sex: string
		phone: string
		address: string
		nursing_grade_id: number
		catering_set_id: number
		bed_id: number
		start_date: string
		end_date: string
	}>({
		name: '',
		id_num: '',
		sex: '男',
		phone: '',
		address: '',
		nursing_grade_id: 0,
		catering_set_id: 0,
		bed_id: 0,
		start_date: '',
		end_date: ''
	})

	const contacts = ref<{ name: string; phone: string; relation: string }[]>([
		{ name: '', phone: '', relation: '' }
	])

	onMounted(() => {
		loadOptions()
	})

	async function loadOptions() {
		try {
			nurseGrades.value = await listNurseGrade()
			cateringSets.value = await listCateringSet()
			beds.value = await listBed()
		} catch (e) {
			// 已统一 toast
		}
	}

	function validateStep0(): boolean {
		if (form.value.name == '') { uni.showToast({ title: '请输入姓名', icon: 'none' }); return false }
		if (form.value.id_num.length != 18) { uni.showToast({ title: '请输入 18 位身份证号', icon: 'none' }); return false }
		if (form.value.phone.length != 11) { uni.showToast({ title: '请输入 11 位手机号', icon: 'none' }); return false }
		if (form.value.address == '') { uni.showToast({ title: '请输入地址', icon: 'none' }); return false }
		return true
	}

	function validateStep1(): boolean {
		if (form.value.nursing_grade_id == 0) { uni.showToast({ title: '请选择护理等级', icon: 'none' }); return false }
		if (form.value.catering_set_id == 0) { uni.showToast({ title: '请选择餐饮套餐', icon: 'none' }); return false }
		if (form.value.bed_id == 0) { uni.showToast({ title: '请选择床位', icon: 'none' }); return false }
		if (form.value.start_date == '' || form.value.end_date == '') { uni.showToast({ title: '请选择合同起止日期', icon: 'none' }); return false }
		return true
	}

	function validateContacts(): boolean {
		for (let i = 0; i < contacts.value.length; i++) {
			if (contacts.value[i].name == '' || contacts.value[i].phone.length != 11) {
				uni.showToast({ title: '请完善第 ' + (i + 1) + ' 位紧急联系人', icon: 'none' })
				return false
			}
		}
		return true
	}

	function onNext() {
		if (current.value == 0 && !validateStep0()) return
		if (current.value == 1 && !validateStep1()) return
		current.value = current.value + 1
	}

	function onPrev() {
		current.value = current.value - 1
	}

	function addContact() {
		contacts.value = contacts.value.concat([{ name: '', phone: '', relation: '' }])
	}

	function removeContact(idx: number) {
		const arr = contacts.value.slice()
		arr.splice(idx, 1)
		contacts.value = arr
	}

	async function doSubmit() {
		if (!validateContacts()) return
		submitting.value = true
		try {
			const payload = {
				name: form.value.name,
				id_num: form.value.id_num,
				sex: form.value.sex,
				age: parseInt(ageStr.value) || 0,
				phone: form.value.phone,
				address: form.value.address,
				nursing_grade_id: form.value.nursing_grade_id,
				catering_set_id: form.value.catering_set_id,
				bed_id: form.value.bed_id,
				start_date: form.value.start_date,
				end_date: form.value.end_date,
				emergency_contacts: contacts.value
			}
			await addEnter(payload)
			uni.showToast({ title: '签约成功', icon: 'success' })
			setTimeout(() => uni.navigateBack(), 500)
		} catch (e) {
			// 已统一 toast
		} finally {
			submitting.value = false
		}
	}
</script>

<style scoped>
	.page {
		flex: 1;
		background-color: #F5F6FA;
	}

	.step {
		background-color: #FFFFFF;
		border-radius: 10px;
		padding: 16px;
	}

	.field {
		flex-direction: column;
		margin-bottom: 16px;
	}

	.field__label {
		font-size: 14px;
		color: #333333;
	}

	.field__label-row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 8px;
	}

	.field__required {
		color: #DD524D;
	}

	.field__input {
		height: 44px;
		background-color: #F5F6FA;
		border-radius: 8px;
		padding-left: 12px;
		font-size: 15px;
	}

	.radio-row {
		flex-direction: row;
	}

	.radio {
		height: 36px;
		padding: 0 20px;
		margin-right: 12px;
		align-items: center;
		justify-content: center;
		border-radius: 18px;
		background-color: #F5F6FA;
	}

	.radio text {
		font-size: 14px;
		color: #666666;
	}

	.radio--active {
		background-color: #007AFF;
	}

	.radio--active text {
		color: #FFFFFF;
	}

	.option {
		height: 40px;
		padding: 0 16px;
		margin-bottom: 8px;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		background-color: #F5F6FA;
	}

	.option text {
		font-size: 14px;
		color: #333333;
	}

	.option--active {
		background-color: #007AFF;
	}

	.option--active text {
		color: #FFFFFF;
	}

	.contact {
		flex-direction: column;
		margin-bottom: 8px;
	}

	.contact__input {
		margin-bottom: 6px;
	}

	.contact__del {
		font-size: 13px;
		color: #DD524D;
		text-align: right;
	}

	.contact__add {
		height: 40px;
		align-items: center;
		justify-content: center;
		border-style: dashed;
		border-width: 1px;
		border-color: #E5E6EB;
		border-radius: 8px;
	}

	.contact__add text {
		font-size: 14px;
		color: #007AFF;
	}

	.summary {
		margin-top: 8px;
		flex-direction: column;
	}

	.summary__row {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 8px;
	}

	.summary__label {
		font-size: 14px;
		color: #999999;
	}

	.summary__value {
		font-size: 14px;
		color: #333333;
		font-weight: 500;
	}
</style>
