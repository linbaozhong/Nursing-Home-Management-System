<template>
	<view class="page">
		<uni-nav-bar :title="'护理预定'" />

		<WizardForm
			:steps="['选择老人', '护理项目', '确认金额']"
			:current="current"
			:disabled="submitting"
			@next="onNext"
			@prev="onPrev"
			@submit="doSubmit"
		>
			<template #step-0>
				<view class="step">
					<view class="field" @click="showElderSearch = true">
						<view class="field__label-row">
							<text class="field__label">老人</text>
							<text class="field__required">*</text>
						</view>
						<view class="field__picker">
							<text v-if="elder.name != ''" class="field__value">{{ elder.name }}</text>
							<text v-else class="field__placeholder">点击选择老人</text>
						</view>
					</view>
				</view>
			</template>

			<template #step-1>
				<view class="step">
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">护理项目</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="form.service_name" placeholder="如：翻身拍背" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">单价(元)</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="priceStr" type="digit" placeholder="每次费用" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">所需时间(分钟)</text>
							<text class="field__required">*</text>
						</view>
						<input class="field__input" v-model="needStr" type="number" placeholder="如：15" />
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">收取方式</text>
							<text class="field__required">*</text>
						</view>
						<view class="radio-row">
							<view v-for="t in chargeOptions" :key="t"
								class="radio" :class="{ 'radio--active': form.charge_method == t }"
								@click="form.charge_method = t">
								<text>{{ t }}</text>
							</view>
						</view>
					</view>
				</view>
			</template>

			<template #step-2>
				<view class="step">
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">服务次数</text>
							<text class="field__required">*</text>
						</view>
						<view class="num-row">
							<view class="num-btn" @click="changeNum(-1)"><text>−</text></view>
							<text class="num-value">{{ form.frequency }}</text>
							<view class="num-btn" @click="changeNum(1)"><text>＋</text></view>
						</view>
					</view>
					<view class="field">
						<view class="field__label-row">
							<text class="field__label">支付总额</text>
						</view>
						<text class="amount">¥{{ payAmount() }}</text>
					</view>
				</view>
			</template>
		</WizardForm>

		<ElderSearch :visible="showElderSearch" @update:visible="showElderSearch = $event" @select="onElderSelect" />
	</view>
</template>

<script setup lang="uts">
	import WizardForm from '../../components/wizard-form/WizardForm.uvue'
	import ElderSearch from '../../components/elder-search/ElderSearch.uvue'
	import { addNurseBook, editNurseBook } from '../../api/nurse-book'

	const current = ref(0)
	const submitting = ref(false)
	const showElderSearch = ref(false)
	const isEdit = ref(false)
	let currentId = 0

	const elder = ref<{ id: number; name: string }>({ id: 0, name: '' })
	const chargeOptions = ['按次', '按日']

	const priceStr = ref('')
	const needStr = ref('')

	const form = ref<{
		service_name: string
		charge_method: string
		frequency: number
	}>({
		service_name: '',
		charge_method: '按次',
		frequency: 1
	})

	function onNext() {
		if (current.value == 0) {
			if (elder.value.id == 0) {
				uni.showToast({ title: '请选择老人', icon: 'none' })
				return
			}
		}
		if (current.value == 1) {
			if (form.value.service_name == '') {
				uni.showToast({ title: '请输入护理项目', icon: 'none' })
				return
			}
			if (priceStr.value == '') {
				uni.showToast({ title: '请输入单价', icon: 'none' })
				return
			}
		}
		current.value = current.value + 1
	}

	function onPrev() {
		current.value = current.value - 1
	}

	function onElderSelect(item: any) {
		elder.value = { id: item.id, name: item.name }
	}

	function changeNum(delta: number) {
		let v = form.value.frequency + delta
		if (v < 1) v = 1
		if (v > 99) v = 99
		form.value.frequency = v
	}

	function payAmount(): number {
		const price = parseFloat(priceStr.value) || 0
		return price * form.value.frequency
	}

	async function doSubmit() {
		submitting.value = true
		try {
			const price = parseFloat(priceStr.value) || 0
			const payload = {
				elder_id: elder.value.id,
				service_name: form.value.service_name,
				service_price: price,
				charge_method: form.value.charge_method,
				need_date: parseInt(needStr.value) || 0,
				frequency: form.value.frequency,
				pay_amount: price * form.value.frequency
			}
			if (isEdit.value) {
				await editNurseBook({ ...payload, id: currentId })
			} else {
				await addNurseBook(payload)
			}
			uni.showToast({ title: '保存成功', icon: 'success' })
			setTimeout(() => uni.navigateBack(), 500)
		} catch (e) {
			// 已统一 toast
		} finally {
			submitting.value = false
		}
	}
</script>

<style scoped>
	.page {
		flex: 1;
		background-color: #F5F6FA;
	}

	.step {
		background-color: #FFFFFF;
		border-radius: 10px;
		padding: 16px;
	}

	.field {
		flex-direction: column;
		margin-bottom: 16px;
	}

	.field__label {
		font-size: 14px;
		color: #333333;
	}

	.field__label-row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 8px;
	}

	.field__required {
		color: #DD524D;
	}

	.field__input {
		height: 44px;
		background-color: #F5F6FA;
		border-radius: 8px;
		padding-left: 12px;
		font-size: 15px;
	}

	.field__picker {
		height: 44px;
		background-color: #F5F6FA;
		border-radius: 8px;
		padding-left: 12px;
		justify-content: center;
	}

	.field__value {
		font-size: 15px;
		color: #333333;
	}

	.field__placeholder {
		font-size: 15px;
		color: #999999;
	}

	.radio-row {
		flex-direction: row;
	}

	.radio {
		height: 36px;
		padding: 0 20px;
		margin-right: 12px;
		align-items: center;
		justify-content: center;
		border-radius: 18px;
		background-color: #F5F6FA;
	}

	.radio text {
		font-size: 14px;
		color: #666666;
	}

	.radio--active {
		background-color: #007AFF;
	}

	.radio--active text {
		color: #FFFFFF;
	}

	.num-row {
		flex-direction: row;
		align-items: center;
	}

	.num-btn {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		background-color: #F5F6FA;
		align-items: center;
		justify-content: center;
	}

	.num-btn text {
		font-size: 18px;
		color: #007AFF;
	}

	.num-value {
		width: 60px;
		text-align: center;
		font-size: 16px;
		color: #333333;
	}

	.amount {
		font-size: 20px;
		font-weight: 700;
		color: #DD524D;
	}
</style>
