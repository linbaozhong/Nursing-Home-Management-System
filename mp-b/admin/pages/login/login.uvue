<template>
	<view class="page">
		<view class="brand">
			<image class="brand__logo" src="/static/logo.png" />
			<text class="brand__title">敬老院员工端</text>
			<text class="brand__sub">养老机构数字化管理平台</text>
		</view>

		<view class="form">
			<view class="field">
				<text class="field__label">手机号</text>
				<input
					class="field__input"
					v-model="phone"
					type="number"
					maxlength="11"
					placeholder="请输入手机号"
				/>
			</view>
			<view class="field">
				<text class="field__label">密码</text>
				<input
					class="field__input"
					v-model="pass"
					type="password"
					placeholder="请输入密码"
					confirm-type="done"
					@confirm="doLogin"
				/>
			</view>

			<button class="submit" :loading="loading" :disabled="loading" @click="doLogin">
				登 录
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { login } from '../../api/account'

	const phone = ref('')
	const pass = ref('')
	const loading = ref(false)

	function validate(): boolean {
		if (phone.value.length != 11) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return false
		}
		if (pass.value == '') {
			uni.showToast({ title: '请输入密码', icon: 'none' })
			return false
		}
		return true
	}

	async function doLogin() {
		if (!validate()) {
			return
		}
		loading.value = true
		try {
			await login({ phone: phone.value, pass: pass.value })
			uni.showToast({ title: '登录成功', icon: 'success' })
			// 跳转到工作台（按权限显示模块入口）
			setTimeout(() => {
				uni.reLaunch({ url: '/pages/index/index' })
			}, 500)
		} catch (e) {
			// 错误已在 request 统一 toast
		} finally {
			loading.value = false
		}
	}
</script>

<style scoped>
	.page {
		flex: 1;
		background-color: #FFFFFF;
		padding-left: 32px;
		padding-right: 32px;
	}

	.brand {
		align-items: center;
		margin-top: 120px;
		margin-bottom: 60px;
	}

	.brand__logo {
		width: 72px;
		height: 72px;
		border-radius: 16px;
	}

	.brand__title {
		margin-top: 16px;
		font-size: 22px;
		font-weight: 700;
		color: #333333;
	}

	.brand__sub {
		margin-top: 6px;
		font-size: 13px;
		color: #999999;
	}

	.form {
		flex-direction: column;
	}

	.field {
		flex-direction: column;
		margin-bottom: 20px;
	}

	.field__label {
		font-size: 14px;
		color: #666666;
		margin-bottom: 8px;
	}

	.field__input {
		height: 48px;
		background-color: #F5F6FA;
		border-radius: 8px;
		padding-left: 14px;
		font-size: 15px;
	}

	.submit {
		margin-top: 20px;
		height: 48px;
		border-radius: 24px;
		background-color: #007AFF;
		color: #FFFFFF;
		font-size: 16px;
		font-weight: 600;
	}
</style>
