	}

	.wx-tip {
		margin-top: 10px;
		text-align: center;
		font-size: 12px;
		color: #999999;
	}

	.divider {
		flex-direction: row;
		align-items: center;
		margin-top: 36px;
		margin-bottom: 28px;
	}

	.divider__line {
		flex: 1;
		height: 1px;
		background-color: #E8E8E8;
	}

	.divider__text {
		padding-left: 12px;
		padding-right: 12px;
		font-size: 12px;
		color: #999999;
	}

	.form {
		flex-direction: column;
	}

	.field__input {
		height: 48px;
		background-color: #F5F6FA;
		border-radius: 8px;
		padding-left: 14px;
		font-size: 15px;
	}

	.field__input--gap {
		margin-top: 12px;
	}

	.btn-pass {
		margin-top: 20px;
		height: 48px;
		border-radius: 24px;
		background-color: #A8DADC;
		color: #333333;
		font-size: 16px;
		font-weight: 600;
	}

	.form__register {
