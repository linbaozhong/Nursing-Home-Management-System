<template>
	<view class="page">
		<scroll-view class="body" scroll-y :show-scrollbar="false">
			<view class="brand">
				<image class="brand__logo" src="/static/logo.png" />
				<text class="brand__title">敬老院员工端</text>
				<text class="brand__sub">养老机构数字化管理平台</text>
			</view>

			<!-- 微信一键登录（主入口） -->
			<view class="wx-entry">
				<button class="btn-wx" :loading="wxLoading" :disabled="wxLoading" @click="doWxLogin">
					微信一键登录
				</button>
				<text class="wx-tip">使用微信授权快速登录，自动匹配您的企业身份</text>
			</view>

			<view class="divider">
				<view class="divider__line" />
				<text class="divider__text">或使用账号密码登录</text>
				<view class="divider__line" />
			</view>

			<!-- 账号密码登录（备用入口） -->
			<view class="form">
				<input
					class="field__input"
					v-model="phone"
					type="number"
					:maxlength="11"
					placeholder="请输入手机号"
				/>
				<input
					class="field__input field__input--gap"
					v-model="pass"
					type="password"
					placeholder="请输入密码"
					confirm-type="done"
					@confirm="doLogin"
				/>

				<button class="btn-pass" :loading="loading" :disabled="loading" @click="doLogin">
					登 录
				</button>
				<text class="form__register" @click="goRegister">没有企业？立即创建企业</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { login, wxLogin, WxLoginResult } from '../../api/account'
	import { setLoginUser, getCurrentTenantId, getToken } from '../../utils/auth'

	const phone = ref('')
	const pass = ref('')
	const loading = ref(false)
	const wxLoading = ref(false)

	/** 打开小程序时自动静默登录尝试 */
	onLoad(() => {
		// 已有登录态直接进入工作台
		if (getToken() != '') {
			uni.reLaunch({ url: '/pages/index/index' })
			return
		}
		autoWxLogin()
	})

	async function autoWxLogin() {
		try {
			const code = await getWxCode()
			const res = await wxLogin(code)
			if (!res.need_bind && res.user != null) {
				setLoginUser(res.user!)
				uni.reLaunch({ url: '/pages/index/index' })
				return
			}
			if (res.need_bind && res.tenants != null && res.tenants.length > 0) {
				uni.navigateTo({ url: '/pages/switch-tenant/switch' })
			}
		} catch (e) {
			// 静默失败，停留在登录页
		}
	}

	/** 微信一键登录 */
	async function doWxLogin() {
		wxLoading.value = true
		try {
			const code = await getWxCode()
			const res = await wxLogin(code)
			handleWxResult(res)
		} catch (e) {
			uni.showToast({ title: '微信登录失败，请重试', icon: 'none' })
		} finally {
			wxLoading.value = false
		}
	}

	function handleWxResult(res: WxLoginResult): void {
		// 唯一企业且已绑定：直接进入工作台
		if (!res.need_bind && res.user != null) {
			setLoginUser(res.user!)
			uni.showToast({ title: '登录成功', icon: 'success' })
			setTimeout(() => uni.reLaunch({ url: '/pages/index/index' }), 400)
			return
		}
		// 多企业：跳转切换企业页
		if (res.need_bind && res.tenants != null && res.tenants.length > 0) {
			uni.navigateTo({ url: '/pages/switch-tenant/switch' })
			return
		}
		// 新用户/未绑定：进入创建企业引导
		uni.navigateTo({ url: '/pages/register/register' })
	}

	/** 调用 uni.login 获取微信 code */
	function getWxCode(): Promise<string> {
		return new Promise<string>((resolve, reject) => {
			uni.login({
				provider: 'weixin',
				success: (res) => {
					if (res.code) {
						resolve(res.code)
					} else {
						reject(new Error('no code'))
					}
				},
				fail: (err) => reject(err)
			})
		})
	}

	function validate(): boolean {
		if (phone.value.length != 11) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return false
		}
		if (pass.value == '') {
			uni.showToast({ title: '请输入密码', icon: 'none' })
			return false
		}
		return true
	}

	async function doLogin() {
		if (!validate()) {
			return
		}
		loading.value = true
		try {
			const data = await login({ phone: phone.value, pass: pass.value })
			// 多企业：跳切换页
			if (data.need_bind && data.tenants != null && data.tenants.length > 0) {
				uni.navigateTo({ url: '/pages/switch-tenant/switch' })
				return
			}
			if (data.need_bind) {
				uni.navigateTo({ url: '/pages/register/register' })
				return
			}
			uni.showToast({ title: '登录成功', icon: 'success' })
			setTimeout(() => uni.reLaunch({ url: '/pages/index/index' }), 400)
		} catch (e) {
			// 错误已在 request 统一 toast
		} finally {
			loading.value = false
		}
	}

	function goRegister(): void {
		uni.navigateTo({ url: '/pages/register/register' })
	}
</script>

