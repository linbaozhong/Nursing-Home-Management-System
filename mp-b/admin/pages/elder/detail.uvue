		font-size: 14px;
		color: #007AFF;
	}

	.card__row {
		flex-direction: row;
		align-items: center;
		margin-top: 8px;
	}

	.card__label {
		width: 70px;
		font-size: 14px;
		color: #999999;
	}

	.card__value {
		flex: 1;
		font-size: 14px;
		color: #333333;
	}

