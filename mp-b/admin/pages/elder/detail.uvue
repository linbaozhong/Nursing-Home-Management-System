	}

	.edit-btn {
		margin-top: 20px;
		height: 46px;
		border-radius: 23px;
		background-color: #007AFF;
		color: #FFFFFF;
		font-size: 15px;
	}

	.mask {
		position: fixed;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5);
		justify-content: flex-end;
		z-index: 999;
	}

	.panel {
		height: 60%;
		background-color: #FFFFFF;
