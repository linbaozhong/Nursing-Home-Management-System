</template>

<script setup lang="uts">
	import { getLoginUser } from '../../utils/auth'
	import { canAccess } from '../../utils/auth'

	interface CfgEntry { type: string; name: string }
	interface CfgGroup { title: string; items: CfgEntry[] }

	const allGroups: CfgGroup[] = [
		{
			title: '基础信息',
			items: [
				{ type: 'source', name: '来源渠道' },
				{ type: 'roomtype', name: '房间类型' },
