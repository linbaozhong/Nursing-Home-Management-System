		justify-content: space-between;
	}

	.card__name {
		font-size: 16px;
		font-weight: 600;
		color: #333333;
	}

	.card__body {
		margin-top: 10px;
	}

	.card__body text {
		font-size: 14px;
		color: #333333;
	}

	.card__foot {
		margin-top: 8px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.card__amount {
		font-size: 14px;
		font-weight: 600;
		color: #DD524D;
	}

	.card__staff {
		font-size: 13px;
		color: #999999;
	}

	.empty {
		align-items: center;
		padding-top: 60px;
	}

	.empty text {
		font-size: 14px;
		color: #999999;
	}

	.card__send {
		height: 28px;
		padding: 0 12px;
		border-radius: 14px;
		background-color: #007AFF;
		align-items: center;
		justify-content: center;
	}

	.card__send text {
		font-size: 13px;
		color: #FFFFFF;
	}

	.fab {
		position: fixed;
		right: 20px;
		bottom: 40px;
	}

	.fab__plus {
		background-color: #007AFF;
	}

	.mask {
		position: fixed;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5);
		justify-content: flex-end;
		z-index: 999;
	}

	.panel {
		height: 55%;
		background-color: #FFFFFF;
		border-top-left-radius: 16px;
		border-top-right-radius: 16px;
		flex-direction: column;
	}

	.panel__head {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 14px 16px;
	}

	.panel__title {
		font-size: 16px;
		font-weight: 600;
		color: #333333;
	}

	.panel__close {
		font-size: 14px;
		color: #999999;
	}

	.panel__list {
		flex: 1;
	}

	.panel__item {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 12px 16px;
		border-bottom-width: 1px;
		border-bottom-color: #F0F0F0;
	}

	.panel__name {
		font-size: 15px;
