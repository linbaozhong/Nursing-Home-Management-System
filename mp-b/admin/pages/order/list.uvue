<template>
	<view class="page">
		<uni-nav-bar :title="'点餐'" />

		<view class="search-bar">
			<input
				class="search-input"
				v-model="keyword"
				placeholder="搜索老人姓名 / 电话"
				confirm-type="search"
			/>
		</view>

		<view class="filter-bar">
			<view
				v-for="s in flagOptions"
				:key="s.value"
				class="filter-item"
				:class="{ 'filter-item--active': flag == s.value }"
				@click="flag = s.value"
			>
				<text>{{ s.label }}</text>
			</view>
		</view>

		<scroll-view class="list" scroll-y :show-scrollbar="false">
			<view v-for="item in filteredList" :key="item.id" class="card" @click="goDetail(item)">
				<view class="card__head">
					<text class="card__name">{{ item.elder_name }}</text>
					<StatusTag :text="flagText(item)" :type="flagType(item)" />
				</view>
				<view class="card__body">
					<text>{{ item.dine_type }} · {{ fmt(item.dine_date) }}</text>
				</view>
				<view class="card__foot">
					<text class="card__amount">{{ formatMoney(item.pay_amount) }}</text>
					<text v-if="isDelivered(item)" class="card__staff">送餐人：{{ item.staff_name }}</text>
					<view v-else-if="item.dine_type == '送餐'" class="card__send" @click.stop="onSend(item)">
						<text>去送餐</text>
					</view>
				</view>
			</view>

			<view v-if="filteredList.length == 0" class="empty">
				<text>暂无点餐记录</text>
			</view>
		</scroll-view>

		<uni-fab-button class="fab" plus-class="fab__plus" @click="goAdd" />

		<!-- 送餐人员选择弹层 -->
		<view v-if="showSendPanel" class="mask" @click="showSendPanel = false">
			<view class="panel" @click.stop>
				<view class="panel__head">
					<text class="panel__title">选择送餐人员</text>
					<text class="panel__close" @click="showSendPanel = false">取消</text>
				</view>
				<scroll-view class="panel__list" scroll-y>
					<view v-for="s in nurseStaffs" :key="s.id" class="panel__item" @click="onSendStaffSelect(s)">
						<text class="panel__name">{{ s.name }}</text>
						<text class="panel__phone">{{ s.phone }}</text>
					</view>
					<view v-if="nurseStaffs.length == 0" class="panel__empty"><text>暂无可用送餐人员</text></view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import StatusTag from '../../components/status-tag/StatusTag.uvue'
	import { onShow } from '@dcloudio/uni-app'
	import { pageOrderByKey, listNurseStaff, sendOrder, OrderItem, NurseStaff } from '../../api/order'
	import { parseTime, formatShortTime, formatMoney, formatDateTime } from '../../utils/util'

	const keyword = ref('')
	const flag = ref('')
	const list = ref<OrderItem[]>([])
	const showSendPanel = ref(false)
	const nurseStaffs = ref<NurseStaff[]>([])
	let sendingOrderId = 0

	const flagOptions = [
		{ label: '全部', value: '' },
		{ label: '待送餐', value: '待' },
		{ label: '已送餐', value: '已' }
	]

	onShow(() => {
		loadData()
	})

	async function loadData() {
		try {
			const res = await pageOrderByKey()
			list.value = res.list
		} catch (e) {
			// 已统一 toast
		}
	}

	async function onSend(item: OrderItem) {
		sendingOrderId = item.id
		showSendPanel.value = true
		if (nurseStaffs.value.length == 0) {
			try {
				nurseStaffs.value = await listNurseStaff()
			} catch (e) {
				// 已统一 toast
			}
		}
	}

	async function onSendStaffSelect(s: NurseStaff) {
		showSendPanel.value = false
		uni.showModal({
			title: '确认送餐',
			content: '由 ' + s.name + ' 负责送餐？',
			success: async (res) => {
				if (res.confirm) {
					try {
						await sendOrder(sendingOrderId, s.id, formatDateTime(new Date()))
						uni.showToast({ title: '已送餐', icon: 'success' })
						loadData()
					} catch (e) {
						// 已统一 toast
					}
				}
			}
		})
	}

	const filteredList = computed((): OrderItem[] => {
		let items = list.value
		const kw = keyword.value.trim()
		if (kw != '') {
			items = items.filter((it) => {
				return it.elder_name.indexOf(kw) >= 0 || it.elder_phone.indexOf(kw) >= 0
			})
		}
		if (flag.value != '') {
			items = items.filter((it) => isDelivered(it) == (flag.value == '已'))
		}
		return items
	})

	function fmt(s: string): string {
		const d = parseTime(s)
		return d ? formatShortTime(d) : ''
	}

	function isDelivered(item: OrderItem): boolean {
		return item.order_flag == '是'
	}

	function flagText(item: OrderItem): string {
		return isDelivered(item) ? '已送餐' : '待送餐'
	}

	function flagType(item: OrderItem): 'success' | 'warning' {
		return isDelivered(item) ? 'success' : 'warning'
	}

	function goDetail(item: OrderItem) {
		uni.navigateTo({ url: '/pages/order/edit?id=' + item.id })
	}

	function goAdd() {
		uni.navigateTo({ url: '/pages/order/edit' })
	}
</script>

