<template>
	<view class="page">
		<uni-nav-bar :title="'创建企业'" />

		<view class="step">
			<view class="step__item" :class="{ 'step__item--on': step >= 1 }">
				<text class="step__num">1</text>
				<text class="step__label">企业信息</text>
			</view>
			<view class="step__item" :class="{ 'step__item--on': step >= 2 }">
				<text class="step__num">2</text>
				<text class="step__label">管理员账号</text>
			</view>
			<view class="step__item" :class="{ 'step__item--on': step >= 3 }">
				<text class="step__num">3</text>
				<text class="step__label">微信绑定</text>
			</view>
		</view>

		<!-- 第一步：企业信息 -->
		<view v-if="step == 1" class="card">
			<view class="field">
				<text class="field__label">企业名称</text>
				<input class="field__input" v-model="name" placeholder="请输入企业名称" />
			</view>
			<view class="field">
				<text class="field__label">联系人姓名</text>
				<input class="field__input" v-model="contactName" placeholder="请输入联系人姓名" />
			</view>
			<view class="field">
				<text class="field__label">联系电话</text>
				<input
					class="field__input"
					v-model="contactPhone"
					type="number"
					:maxlength="11"
					placeholder="请输入联系电话（管理员手机号）"
				/>
			</view>
			<button class="btn-next" @click="next1">下一步</button>
		</view>

		<!-- 第二步：管理员账号 -->
		<view v-else-if="step == 2" class="card">
			<view class="field">
				<text class="field__label">登录密码</text>
				<input
					class="field__input"
					v-model="password"
					type="password"
					:maxlength="20"
					placeholder="请设置登录密码"
				/>
			</view>
			<view class="field">
				<text class="field__label">确认密码</text>
				<input
					class="field__input"
					v-model="confirmPass"
					type="password"
					:maxlength="20"
					placeholder="请再次输入密码"
				/>
			</view>
			<button class="btn-next" @click="next2">下一步</button>
		</view>

		<!-- 第三步：绑定微信，确认开通 -->
		<view v-else-if="step == 3" class="card">
			<view class="summary">
				<view class="summary__row">
					<text class="summary__label">企业名称</text>
					<text class="summary__value">{{ name }}</text>
				</view>
				<view class="summary__row">
					<text class="summary__label">管理员</text>
					<text class="summary__value">{{ contactName }}（{{ contactPhone }}）</text>
				</view>
			</view>
			<text class="trial-tip">注册即开通 30 天免费试用，试用结束自动锁定</text>
			<button class="btn-submit" :loading="submitting" :disabled="submitting" @click="doRegister">
				创建企业并绑定微信
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { registerTenant } from '../../api/tenant'

	const step = ref(1)
	const name = ref('')
	const contactName = ref('')
	const contactPhone = ref('')
	const password = ref('')
	const confirmPass = ref('')
	const wxCode = ref('')
	const submitting = ref(false)

	function next1(): void {
		if (name.value == '') {
			uni.showToast({ title: '请输入企业名称', icon: 'none' })
			return
		}
		if (contactName.value == '') {
			uni.showToast({ title: '请输入联系人姓名', icon: 'none' })
			return
		}
		if (contactPhone.value.length != 11) {
			uni.showToast({ title: '请输入正确的联系电话', icon: 'none' })
			return
		}
		step.value = 2
	}

	function next2(): void {
		if (password.value.length < 6) {
			uni.showToast({ title: '密码至少 6 位', icon: 'none' })
			return
		}
		if (password.value != confirmPass.value) {
			uni.showToast({ title: '两次密码不一致', icon: 'none' })
			return
		}
		step.value = 3
	}

	/** 获取微信 code 用于绑定微信 */
	function getWxCode(): Promise<string> {
		return new Promise<string>((resolve, reject) => {
			uni.login({
				provider: 'weixin',
				success: (res) => {
					if (res.code) {
						resolve(res.code)
					} else {
						reject(new Error('no code'))
					}
				},
				fail: (err) => reject(err)
			})
		})
	}

	async function doRegister() {
		submitting.value = true
		try {
			try {
				wxCode.value = await getWxCode()
			} catch (e) {
				wxCode.value = ''
			}
			await registerTenant({
				name: name.value,
				contact_name: contactName.value,
				contact_phone: contactPhone.value,
				password: password.value,
				wx_code: wxCode.value
			})
			uni.showToast({ title: '创建成功', icon: 'success' })
			setTimeout(() => uni.reLaunch({ url: '/pages/index/index' }), 500)
		} catch (e) {
			// 错误已在 request 统一 toast
		} finally {
			submitting.value = false
		}
	}
</script>

<style scoped>
	.page {
		flex: 1;
		background-color: #F5F7FA;
		padding-left: 24px;
		padding-right: 24px;
	}

	.step {
		flex-direction: row;
		justify-content: space-between;
		margin-top: 24px;
		margin-bottom: 24px;
	}

	.step__item {
		flex-direction: column;
		align-items: center;
	}

	.step__num {
		width: 28px;
		height: 28px;
		line-height: 28px;
		text-align: center;
		border-radius: 14px;
		background-color: #E1E6EC;
		color: #999999;
		font-size: 13px;
	}

	.step__item--on .step__num {
		background-color: #2E86AB;
		color: #FFFFFF;
	}

	.step__item--on .step__label {
		color: #2E86AB;
	}

	.step__label {
		margin-top: 6px;
		font-size: 12px;
		color: #999999;
	}

	.card {
		background-color: #FFFFFF;
		border-radius: 12px;
		padding: 24px;
	}

	.field {
		flex-direction: column;
		margin-bottom: 18px;
	}

	.field__label {
		font-size: 14px;
		color: #666666;
		margin-bottom: 8px;
	}

	.field__input {
		height: 46px;
		background-color: #F5F6FA;
		border-radius: 8px;
		padding-left: 14px;
		font-size: 15px;
	}

	.btn-next {
		margin-top: 12px;
		height: 46px;
		border-radius: 23px;
		background-color: #2E86AB;
		color: #FFFFFF;
		font-size: 15px;
		font-weight: 600;
	}

	.summary {
		flex-direction: column;
	}

	.summary__row {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 14px;
	}

	.summary__label {
		font-size: 14px;
		color: #999999;
	}

	.summary__value {
		font-size: 14px;
		color: #333333;
		font-weight: 500;
	}

	.trial-tip {
		margin-top: 12px;
		font-size: 12px;
		color: #F39C12;
	}

	.btn-submit {
		margin-top: 24px;
		height: 48px;
		border-radius: 24px;
		background-color: #2E86AB;
		color: #FFFFFF;
		font-size: 16px;
		font-weight: 600;
	}
</style>
