		flex: 1;
		background-color: #F5F6FA;
	}

	.body {
		flex: 1;
		padding: 10px 16px;
	}

	.card {
		background-color: #FFFFFF;
		border-radius: 10px;
		padding: 14px;
		margin-bottom: 12px;
	}

	.card__head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}

	.card__name {
		font-size: 18px;
		font-weight: 700;
		color: #333333;
	}

	.card__row {
		flex-direction: row;
		align-items: center;
		margin-top: 8px;
	}

	.card__label {
		width: 80px;
		font-size: 14px;
		color: #999999;
	}

	.card__value {
		flex: 1;
		font-size: 14px;
		color: #333333;
	}

	.card__title {
		font-size: 15px;
		font-weight: 600;
		color: #333333;
	}

	.card__desc {
		margin-top: 10px;
		font-size: 14px;
		color: #333333;
		line-height: 22px;
	}

	.card__img {
		width: 100%;
		height: 200px;
		border-radius: 8px;
		margin-top: 10px;
	}

	.actions {
		flex-direction: row;
		margin-bottom: 12px;
	}

	.action {
		flex: 1;
		height: 44px;
		border-radius: 22px;
		align-items: center;
		justify-content: center;
		margin: 0 6px;
	}

	.action text {
		font-size: 15px;
		color: #FFFFFF;
	}

	.action--primary {
		background-color: #007AFF;
	}

	.action--danger {
		background-color: #DD524D;
	}
</style>
