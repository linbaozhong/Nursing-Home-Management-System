<template>
	<view class="page">
		<uni-nav-bar :title="'事故详情'" />

		<scroll-view class="body" scroll-y :show-scrollbar="false">
			<view class="card">
				<view class="card__head">
					<text class="card__name">{{ data.elder_name }}</text>
					<StatusTag text="事故" type="danger" />
				</view>
				<view class="card__row">
					<text class="card__label">发生时间</text>
					<text class="card__value">{{ fmt(data.occur_date) }}</text>
				</view>
				<view class="card__row">
					<text class="card__label">护工编号</text>
					<text class="card__value">{{ data.staff_id }}</text>
				</view>
			</view>

			<view class="card">
				<text class="card__title">事故描述</text>
				<text class="card__desc">{{ data.description }}</text>
			</view>

			<view v-if="data.picture != ''" class="card">
				<text class="card__title">现场图片</text>
				<image class="card__img" :src="data.picture" mode="aspectFill" @click="preview" />
			</view>

			<view class="actions">
				<view class="action action--primary" @click="goEdit">
					<text>编辑</text>
				</view>
				<view class="action action--danger" @click="doDelete">
					<text>删除</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { onLoad } from '@dcloudio/uni-app'
	import { getAccidentById, deleteAccident } from '../../api/accident'
	import { parseTime, formatShortTime } from '../../utils/util'

	const data = ref<any>({})
	let currentId = 0

	onLoad((options) => {
		const id = Number(options?.id)
		if (id > 0) {
			currentId = id
			loadData(id)
		}
	})

	async function loadData(id: number) {
		try {
			const res = await getAccidentById(id)
			data.value = res
		} catch (e) {
			// 已统一 toast
		}
	}

	function fmt(s: string): string {
		const d = parseTime(s)
		return d ? formatShortTime(d) : ''
	}

	function preview() {
		uni.previewImage({ urls: [data.value.picture] })
	}

	function goEdit() {
		uni.navigateTo({ url: '/pages/accident/edit?id=' + currentId })
	}

	function doDelete() {
		uni.showModal({
			title: '删除',
			content: '确认删除该事故记录？',
			success: async (res) => {
				if (res.confirm) {
					try {
						await deleteAccident(currentId)
						uni.showToast({ title: '已删除', icon: 'success' })
						setTimeout(() => uni.navigateBack(), 500)
					} catch (e) { }
				}
			}
		})
	}
</script>

