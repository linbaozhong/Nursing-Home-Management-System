<template>
	<view class="page">
		<uni-nav-bar :title="'我的'">
			<template #right>
				<view class="nav-btn" @click="goConfig">
					<text class="nav-btn__icon">⚙</text>
				</view>
			</template>
		</uni-nav-bar>

		<view class="profile">
			<image v-if="user && user.avator != ''" class="avatar" :src="user.avator" />
			<view v-else class="avatar avatar--placeholder">
				<text>{{ user ? user.name.charAt(0) : '员' }}</text>
			</view>
			<view class="profile__info">
				<text class="profile__name">{{ user ? user.name : '未登录' }}</text>
				<text class="profile__phone">{{ user ? user.phone : '' }}</text>
			</view>
		</view>

		<view class="menu">
			<view class="menu__item" @click="goEditPass">
				<text class="menu__label">修改密码</text>
				<text class="menu__arrow">›</text>
			</view>
			<view class="menu__item" @click="doLogout">
				<text class="menu__label menu__label--danger">退出登录</text>
				<text class="menu__arrow">›</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onShow } from '@dcloudio/uni-app'
	import { getLoginUser, clearAuth, LoginUser } from '../../utils/auth'

	const user = ref<LoginUser | null>(null)

	onShow(() => {
		user.value = getLoginUser()
	})

	function goEditPass() {
		uni.navigateTo({ url: '/pages/mine/edit-pass' })
	}

	function goConfig() {
		uni.navigateTo({ url: '/pages/config/index' })
	}

	function doLogout() {
		uni.showModal({
			title: '提示',
			content: '确认退出登录？',
			success: (res) => {
				if (res.confirm) {
					clearAuth()
					uni.reLaunch({ url: '/pages/login/login' })
				}
			}
		})
	}
</script>

<style scoped>
